<Window x:Class="Appli_CocoriCO2.DesalinatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Appli_CocoriCO2"
        mc:Ignorable="d"
        Title="Desalinator Data &amp; Parameters" Height="600" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Desalinator Data Section -->
        <GroupBox Header="Desalinator Data" Grid.Row="0" Margin="5">
            <ScrollViewer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>

                    <!-- Headers -->
                    <Label Content="Parameter" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                    <Label Content="Value" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>
                    <Label Content="Unit" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>

                    <!-- Pressure Data -->
                    <Label Content="Pressure HP:" Grid.Row="1" Grid.Column="0"/>
                    <Label x:Name="lbl_pressionHP" Grid.Row="1" Grid.Column="1"/>
                    <Label Content="bars" Grid.Row="1" Grid.Column="2"/>

                    <Label Content="Pressure Entree:" Grid.Row="2" Grid.Column="0"/>
                    <Label x:Name="lbl_pressionEntree" Grid.Row="2" Grid.Column="1"/>
                    <Label Content="bars" Grid.Row="2" Grid.Column="2"/>

                    <Label Content="Pressure Saumure:" Grid.Row="3" Grid.Column="0"/>
                    <Label x:Name="lbl_pressionSaumure" Grid.Row="3" Grid.Column="1"/>
                    <Label Content="bars" Grid.Row="3" Grid.Column="2"/>

                    <Label Content="Pressure Fresh:" Grid.Row="4" Grid.Column="0"/>
                    <Label x:Name="lbl_pressionFresh" Grid.Row="4" Grid.Column="1"/>
                    <Label Content="bars" Grid.Row="4" Grid.Column="2"/>

                    <!-- Flow Data -->
                    <Label Content="Debit Entree:" Grid.Row="5" Grid.Column="0"/>
                    <Label x:Name="lbl_debitEntree" Grid.Row="5" Grid.Column="1"/>
                    <Label Content="L/min" Grid.Row="5" Grid.Column="2"/>

                    <Label Content="Debit MOI:" Grid.Row="6" Grid.Column="0"/>
                    <Label x:Name="lbl_debitMOI" Grid.Row="6" Grid.Column="1"/>
                    <Label Content="L/min" Grid.Row="6" Grid.Column="2"/>

                    <Label Content="Debit Recirculation:" Grid.Row="7" Grid.Column="0"/>
                    <Label x:Name="lbl_debitRecirculation" Grid.Row="7" Grid.Column="1"/>
                    <Label Content="L/min" Grid.Row="7" Grid.Column="2"/>

                    <Label Content="Debit Fresh:" Grid.Row="8" Grid.Column="0"/>
                    <Label x:Name="lbl_debitFresh" Grid.Row="8" Grid.Column="1"/>
                    <Label Content="L/min" Grid.Row="8" Grid.Column="2"/>

                    <!-- Valve Data -->
                    <Label Content="Vanne Entree:" Grid.Row="9" Grid.Column="0"/>
                    <Label x:Name="lbl_vanneEntree" Grid.Row="9" Grid.Column="1"/>
                    <Label Content="%" Grid.Row="9" Grid.Column="2"/>

                    <Label Content="Vanne Saumure:" Grid.Row="10" Grid.Column="0"/>
                    <Label x:Name="lbl_vanneSaumure" Grid.Row="10" Grid.Column="1"/>
                    <Label Content="%" Grid.Row="10" Grid.Column="2"/>

                    <Label Content="Vanne Fresh:" Grid.Row="11" Grid.Column="0"/>
                    <Label x:Name="lbl_vanneFresh" Grid.Row="11" Grid.Column="1"/>
                    <Label Content="%" Grid.Row="11" Grid.Column="2"/>

                    <Label Content="V3V MOI:" Grid.Row="12" Grid.Column="0"/>
                    <Label x:Name="lbl_v3VMOI" Grid.Row="12" Grid.Column="1"/>
                    <Label Content="%" Grid.Row="12" Grid.Column="2"/>

                    <!-- Pump and Other Data -->
                    <Label Content="Pompe HP:" Grid.Row="13" Grid.Column="0"/>
                    <Label x:Name="lbl_pompeHP" Grid.Row="13" Grid.Column="1"/>
                    <Label Content="" Grid.Row="13" Grid.Column="2"/>

                    <Label Content="Conductivity:" Grid.Row="14" Grid.Column="0"/>
                    <Label x:Name="lbl_conductivity" Grid.Row="14" Grid.Column="1"/>
                    <Label Content="mS/cm" Grid.Row="14" Grid.Column="2"/>

                    <Label Content="Salinity:" Grid.Row="15" Grid.Column="0"/>
                    <Label x:Name="lbl_salinity" Grid.Row="15" Grid.Column="1"/>
                    <Label Content="PSU" Grid.Row="15" Grid.Column="2"/>

                    <Label Content="Temperature:" Grid.Row="16" Grid.Column="0"/>
                    <Label x:Name="lbl_temperature" Grid.Row="16" Grid.Column="1"/>
                    <Label Content="°C" Grid.Row="16" Grid.Column="2"/>

                    <Label Content="Last Updated:" Grid.Row="17" Grid.Column="0"/>
                    <Label x:Name="lbl_lastUpdated" Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <!-- Desalinator Parameters Section -->
        <GroupBox Header="Desalinator Parameters" Grid.Row="1" Margin="5">
            <ScrollViewer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- Headers -->
                    <Label Content="Regulation" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                    <Label Content="Consigne" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>
                    <Label Content="Kp" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>
                    <Label Content="Ki" Grid.Row="0" Grid.Column="3" FontWeight="Bold"/>
                    <Label Content="Kd" Grid.Row="0" Grid.Column="4" FontWeight="Bold"/>
                    <Label Content="PID Output" Grid.Row="0" Grid.Column="5" FontWeight="Bold"/>
                    <Label Content="Override" Grid.Row="0" Grid.Column="6" FontWeight="Bold"/>
                    <Label Content="Force Value" Grid.Row="0" Grid.Column="7" FontWeight="Bold"/>

                    <!-- Regulation Entree -->
                    <Label Content="Pressure Entree:" Grid.Row="1" Grid.Column="0"/>
                    <Label x:Name="lbl_param_entree_cons" Grid.Row="1" Grid.Column="1"/>
                    <Label x:Name="lbl_param_entree_kp" Grid.Row="1" Grid.Column="2"/>
                    <Label x:Name="lbl_param_entree_ki" Grid.Row="1" Grid.Column="3"/>
                    <Label x:Name="lbl_param_entree_kd" Grid.Row="1" Grid.Column="4"/>
                    <Label x:Name="lbl_param_entree_pid" Grid.Row="1" Grid.Column="5"/>
                    <Label x:Name="lbl_param_entree_override" Grid.Row="1" Grid.Column="6"/>
                    <Label x:Name="lbl_param_entree_force" Grid.Row="1" Grid.Column="7"/>

                    <!-- Regulation Saumure -->
                    <Label Content="Pressure Saumure:" Grid.Row="2" Grid.Column="0"/>
                    <Label x:Name="lbl_param_saumure_cons" Grid.Row="2" Grid.Column="1"/>
                    <Label x:Name="lbl_param_saumure_kp" Grid.Row="2" Grid.Column="2"/>
                    <Label x:Name="lbl_param_saumure_ki" Grid.Row="2" Grid.Column="3"/>
                    <Label x:Name="lbl_param_saumure_kd" Grid.Row="2" Grid.Column="4"/>
                    <Label x:Name="lbl_param_saumure_pid" Grid.Row="2" Grid.Column="5"/>
                    <Label x:Name="lbl_param_saumure_override" Grid.Row="2" Grid.Column="6"/>
                    <Label x:Name="lbl_param_saumure_force" Grid.Row="2" Grid.Column="7"/>

                    <!-- Regulation Fresh -->
                    <Label Content="Pressure Fresh:" Grid.Row="3" Grid.Column="0"/>
                    <Label x:Name="lbl_param_fresh_cons" Grid.Row="3" Grid.Column="1"/>
                    <Label x:Name="lbl_param_fresh_kp" Grid.Row="3" Grid.Column="2"/>
                    <Label x:Name="lbl_param_fresh_ki" Grid.Row="3" Grid.Column="3"/>
                    <Label x:Name="lbl_param_fresh_kd" Grid.Row="3" Grid.Column="4"/>
                    <Label x:Name="lbl_param_fresh_pid" Grid.Row="3" Grid.Column="5"/>
                    <Label x:Name="lbl_param_fresh_override" Grid.Row="3" Grid.Column="6"/>
                    <Label x:Name="lbl_param_fresh_force" Grid.Row="3" Grid.Column="7"/>

                    <!-- Pompe HP Control -->
                    <Label Content="Pompe HP:" Grid.Row="5" Grid.Column="0" FontWeight="Bold"/>
                    <Button x:Name="btn_pompeHP" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                            Height="25" Click="btn_pompeHP_Click" FontWeight="Bold"/>

                    <!-- Pressure HP Threshold -->
                    <Label Content="Pressure HP Threshold:" Grid.Row="6" Grid.Column="0" FontWeight="Bold"/>
                    <TextBox x:Name="txt_pressureHPThreshold" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                             Height="25" VerticalContentAlignment="Center" TextChanged="txt_pressureHPThreshold_TextChanged"/>
                    <Label Content="bars" Grid.Row="6" Grid.Column="3"/>
                    <Button x:Name="btn_setPressureThreshold" Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="2"
                            Content="Set Threshold" Height="25" Click="btn_setPressureThreshold_Click"/>

                    <!-- Pression Entree Threshold -->
                    <Label Content="Pression Entree Threshold:" Grid.Row="7" Grid.Column="0" FontWeight="Bold"/>
                    <TextBox x:Name="txt_pressionEntreeThreshold" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                             Height="25" VerticalContentAlignment="Center"/>
                    <Label Content="bars" Grid.Row="7" Grid.Column="3"/>
                    <Button x:Name="btn_setPressionEntreeThreshold" Grid.Row="7" Grid.Column="4" Grid.ColumnSpan="2"
                            Content="Set Threshold" Height="25" Click="btn_setPressionEntreeThreshold_Click"/>

                    <!-- Debit MOI Threshold -->
                    <Label Content="Debit MOI Threshold:" Grid.Row="8" Grid.Column="0" FontWeight="Bold"/>
                    <TextBox x:Name="txt_debitMOIThreshold" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                             Height="25" VerticalContentAlignment="Center"/>
                    <Label Content="L/min" Grid.Row="8" Grid.Column="3"/>
                    <Button x:Name="btn_setDebitMOIThreshold" Grid.Row="8" Grid.Column="4" Grid.ColumnSpan="2"
                            Content="Set Threshold" Height="25" Click="btn_setDebitMOIThreshold_Click"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>