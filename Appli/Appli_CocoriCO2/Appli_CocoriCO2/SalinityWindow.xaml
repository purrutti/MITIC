<Window x:Class="Appli_CocoriCO2.SalinityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Appli_CocoriCO2"
        mc:Ignorable="d"
        Title="Salinity Regulation Data &amp; Parameters" Height="700" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Salinity Data Section -->
        <GroupBox Header="Salinity Data" Grid.Row="0" Margin="5">
            <ScrollViewer>
                <StackPanel>
                    <!-- Salinity Data Table -->
                    <Label Content="Salinity Conditions" FontWeight="Bold" FontSize="14" Margin="5"/>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <!-- Headers -->
                        <Label Content="Parameter" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                        <Label Content="Control" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>
                        <Label Content="C0" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>
                        <Label Content="C1" Grid.Row="0" Grid.Column="3" FontWeight="Bold"/>
                        <Label Content="C2" Grid.Row="0" Grid.Column="4" FontWeight="Bold"/>
                        <Label Content="C3" Grid.Row="0" Grid.Column="5" FontWeight="Bold"/>
                        <Label Content="Unit" Grid.Row="0" Grid.Column="6" FontWeight="Bold"/>

                        <!-- Salinity -->
                        <Label Content="Salinity:" Grid.Row="1" Grid.Column="0"/>
                        <Label x:Name="lbl_saliniteControl" Grid.Row="1" Grid.Column="1"/>
                        <Label x:Name="lbl_saliniteC0" Grid.Row="1" Grid.Column="2"/>
                        <Label x:Name="lbl_saliniteC1" Grid.Row="1" Grid.Column="3"/>
                        <Label x:Name="lbl_saliniteC2" Grid.Row="1" Grid.Column="4"/>
                        <Label x:Name="lbl_saliniteC3" Grid.Row="1" Grid.Column="5"/>
                        <Label Content="PSU" Grid.Row="1" Grid.Column="6"/>

                        <!-- Temperature -->
                        <Label Content="Temperature:" Grid.Row="2" Grid.Column="0"/>
                        <Label x:Name="lbl_temperatureControl" Grid.Row="2" Grid.Column="1"/>
                        <Label x:Name="lbl_temperatureC0" Grid.Row="2" Grid.Column="2"/>
                        <Label x:Name="lbl_temperatureC1" Grid.Row="2" Grid.Column="3"/>
                        <Label x:Name="lbl_temperatureC2" Grid.Row="2" Grid.Column="4"/>
                        <Label x:Name="lbl_temperatureC3" Grid.Row="2" Grid.Column="5"/>
                        <Label Content="°C" Grid.Row="2" Grid.Column="6"/>

                        <!-- Conductivity -->
                        <Label Content="Conductivity:" Grid.Row="3" Grid.Column="0"/>
                        <Label x:Name="lbl_conductiviteControl" Grid.Row="3" Grid.Column="1"/>
                        <Label x:Name="lbl_conductiviteC0" Grid.Row="3" Grid.Column="2"/>
                        <Label x:Name="lbl_conductiviteC1" Grid.Row="3" Grid.Column="3"/>
                        <Label x:Name="lbl_conductiviteC2" Grid.Row="3" Grid.Column="4"/>
                        <Label x:Name="lbl_conductiviteC3" Grid.Row="3" Grid.Column="5"/>
                        <Label Content="µS/cm" Grid.Row="3" Grid.Column="6"/>

                        <!-- Debit -->
                        <Label Content="Flow Rate:" Grid.Row="4" Grid.Column="0"/>
                        <Label Content="-" Grid.Row="4" Grid.Column="1"/>
                        <Label x:Name="lbl_debitC0" Grid.Row="4" Grid.Column="2"/>
                        <Label x:Name="lbl_debitC1" Grid.Row="4" Grid.Column="3"/>
                        <Label x:Name="lbl_debitC2" Grid.Row="4" Grid.Column="4"/>
                        <Label x:Name="lbl_debitC3" Grid.Row="4" Grid.Column="5"/>
                        <Label Content="L/min" Grid.Row="4" Grid.Column="6"/>

                        <!-- Vanne -->
                        <Label Content="Valve Opening:" Grid.Row="5" Grid.Column="0"/>
                        <Label Content="-" Grid.Row="5" Grid.Column="1"/>
                        <Label x:Name="lbl_vanneC0" Grid.Row="5" Grid.Column="2"/>
                        <Label x:Name="lbl_vanneC1" Grid.Row="5" Grid.Column="3"/>
                        <Label x:Name="lbl_vanneC2" Grid.Row="5" Grid.Column="4"/>
                        <Label x:Name="lbl_vanneC3" Grid.Row="5" Grid.Column="5"/>
                        <Label Content="%" Grid.Row="5" Grid.Column="6"/>
                    </Grid>

                    <!-- CTD Data Table -->
                    <Label Content="CTD Data" FontWeight="Bold" FontSize="14" Margin="5,15,5,5"/>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <!-- Headers -->
                        <Label Content="Parameter" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                        <Label Content="Value" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>
                        <Label Content="Unit" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>

                        <!-- CTD Data -->
                        <Label Content="CTD Temperature:" Grid.Row="1" Grid.Column="0"/>
                        <Label x:Name="lbl_ctd_temperature" Grid.Row="1" Grid.Column="1"/>
                        <Label Content="°C" Grid.Row="1" Grid.Column="2"/>

                        <Label Content="CTD Conductivity:" Grid.Row="2" Grid.Column="0"/>
                        <Label x:Name="lbl_ctd_conductivity" Grid.Row="2" Grid.Column="1"/>
                        <Label Content="S/m" Grid.Row="2" Grid.Column="2"/>

                        <Label Content="CTD Oxygen:" Grid.Row="3" Grid.Column="0"/>
                        <Label x:Name="lbl_ctd_oxygen" Grid.Row="3" Grid.Column="1"/>
                        <Label Content="" Grid.Row="3" Grid.Column="2"/>

                        <Label Content="CTD PSU:" Grid.Row="4" Grid.Column="0"/>
                        <Label x:Name="lbl_ctd_psu" Grid.Row="4" Grid.Column="1"/>
                        <Label Content="PSU" Grid.Row="4" Grid.Column="2"/>

                        <Label Content="Calculated PSU:" Grid.Row="5" Grid.Column="0"/>
                        <Label x:Name="lbl_ctd_calculated_psu" Grid.Row="5" Grid.Column="1"/>
                        <Label Content="PSU" Grid.Row="5" Grid.Column="2"/>

                        <Label Content="CTD Date:" Grid.Row="6" Grid.Column="0"/>
                        <Label x:Name="lbl_ctd_date" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"/>

                        <Label Content="CTD Time:" Grid.Row="7" Grid.Column="0"/>
                        <Label x:Name="lbl_ctd_time" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"/>

                        <Label Content="Last Updated:" Grid.Row="8" Grid.Column="0"/>
                        <Label x:Name="lbl_lastUpdated" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Regulation Parameters Section -->
        <GroupBox Header="Regulation Parameters" Grid.Row="1" Margin="5">
            <ScrollViewer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>

                    <!-- Headers -->
                    <Label Content="Regulation" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                    <Label Content="Consigne" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>
                    <Label Content="Kp" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>
                    <Label Content="Ki" Grid.Row="0" Grid.Column="3" FontWeight="Bold"/>
                    <Label Content="Kd" Grid.Row="0" Grid.Column="4" FontWeight="Bold"/>
                    <Label Content="PID Output" Grid.Row="0" Grid.Column="5" FontWeight="Bold"/>

                    <!-- Regulation C0 -->
                    <Label Content="Condition C0:" Grid.Row="1" Grid.Column="0"/>
                    <Label x:Name="lbl_param_c0_cons" Grid.Row="1" Grid.Column="1"/>
                    <Label x:Name="lbl_param_c0_kp" Grid.Row="1" Grid.Column="2"/>
                    <Label x:Name="lbl_param_c0_ki" Grid.Row="1" Grid.Column="3"/>
                    <Label x:Name="lbl_param_c0_kd" Grid.Row="1" Grid.Column="4"/>
                    <Label x:Name="lbl_param_c0_pid" Grid.Row="1" Grid.Column="5"/>

                    <!-- Regulation C1 -->
                    <Label Content="Condition C1:" Grid.Row="2" Grid.Column="0"/>
                    <Label x:Name="lbl_param_c1_cons" Grid.Row="2" Grid.Column="1"/>
                    <Label x:Name="lbl_param_c1_kp" Grid.Row="2" Grid.Column="2"/>
                    <Label x:Name="lbl_param_c1_ki" Grid.Row="2" Grid.Column="3"/>
                    <Label x:Name="lbl_param_c1_kd" Grid.Row="2" Grid.Column="4"/>
                    <Label x:Name="lbl_param_c1_pid" Grid.Row="2" Grid.Column="5"/>

                    <!-- Regulation C2 -->
                    <Label Content="Condition C2:" Grid.Row="3" Grid.Column="0"/>
                    <Label x:Name="lbl_param_c2_cons" Grid.Row="3" Grid.Column="1"/>
                    <Label x:Name="lbl_param_c2_kp" Grid.Row="3" Grid.Column="2"/>
                    <Label x:Name="lbl_param_c2_ki" Grid.Row="3" Grid.Column="3"/>
                    <Label x:Name="lbl_param_c2_kd" Grid.Row="3" Grid.Column="4"/>
                    <Label x:Name="lbl_param_c2_pid" Grid.Row="3" Grid.Column="5"/>

                    <!-- Regulation C3 -->
                    <Label Content="Condition C3:" Grid.Row="4" Grid.Column="0"/>
                    <Label x:Name="lbl_param_c3_cons" Grid.Row="4" Grid.Column="1"/>
                    <Label x:Name="lbl_param_c3_kp" Grid.Row="4" Grid.Column="2"/>
                    <Label x:Name="lbl_param_c3_ki" Grid.Row="4" Grid.Column="3"/>
                    <Label x:Name="lbl_param_c3_kd" Grid.Row="4" Grid.Column="4"/>
                    <Label x:Name="lbl_param_c3_pid" Grid.Row="4" Grid.Column="5"/>

                    <!-- Regulation C2 Filtre -->
                    <Label Content="C2 Filtre:" Grid.Row="5" Grid.Column="0"/>
                    <Label x:Name="lbl_param_c2f_cons" Grid.Row="5" Grid.Column="1"/>
                    <Label x:Name="lbl_param_c2f_kp" Grid.Row="5" Grid.Column="2"/>
                    <Label x:Name="lbl_param_c2f_ki" Grid.Row="5" Grid.Column="3"/>
                    <Label x:Name="lbl_param_c2f_kd" Grid.Row="5" Grid.Column="4"/>
                    <Label x:Name="lbl_param_c2f_pid" Grid.Row="5" Grid.Column="5"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>