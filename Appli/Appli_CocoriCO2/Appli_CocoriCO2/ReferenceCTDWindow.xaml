<Window x:Class="Appli_CocoriCO2.ReferenceCTDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Appli_CocoriCO2"
        mc:Ignorable="d"
        Title="CTD Reference" Height="600" Width="1050" Closing="Window_Closing_1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Label Content="Référence CTD - Sondes de Salinité" FontWeight="Bold" FontSize="16"
               HorizontalAlignment="Center" Margin="10" Grid.Row="0"/>

        <!-- Configuration panneau -->
        <GroupBox Header="Configuration" Grid.Row="1" Margin="10,0,10,10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Content="Temps de moyenne (minutes):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txt_averaging_time" Width="60" Height="25" VerticalAlignment="Center"
                         Text="10" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="btn_apply_time" Content="Appliquer" Width="100" Height="25"
                        Click="btn_ApplyAveragingTime_Click" Margin="0,0,20,0"/>
                <Label x:Name="lbl_samples_info" Content="(10 échantillons actuels)"
                       VerticalAlignment="Center" FontStyle="Italic" Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- Data Table -->
        <GroupBox Header="Valeurs des sondes de salinité" Grid.Row="2" Margin="10">
            <ScrollViewer>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- Headers -->
                    <Label Content="Sonde" Grid.Row="0" Grid.Column="0" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Label Content="Valeur instantanée" Grid.Row="0" Grid.Column="1" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Label Content="Valeur moyenne" Grid.Row="0" Grid.Column="2" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Label Content="Coeff calculé" Grid.Row="0" Grid.Column="3" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Label Content="Coeff actuellement appliqué" Grid.Row="0" Grid.Column="4" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,-69,5" Width="210"/>

                    <!-- CTD -->
                    <Label Content="CTD" Grid.Row="1" Grid.Column="0" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10,0"/>
                    <Label x:Name="lbl_ctd_instant" Grid.Row="1" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_ctd_moyenne" Grid.Row="1" Grid.Column="2"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_ctd_facteur" Grid.Row="1" Grid.Column="3"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_ctd_actuel" Grid.Row="1" Grid.Column="4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="1.0000" FontWeight="Bold"/>

                    <!-- Control -->
                    <Label Content="Control" Grid.Row="2" Grid.Column="0"
                           VerticalAlignment="Center" Margin="10,0"/>
                    <Label x:Name="lbl_control_instant" Grid.Row="2" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_control_moyenne" Grid.Row="2" Grid.Column="2"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_control_facteur" Grid.Row="2" Grid.Column="3"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_control_actuel" Grid.Row="2" Grid.Column="4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--" FontWeight="Bold"/>

                    <!-- C0 -->
                    <Label Content="C0" Grid.Row="3" Grid.Column="0"
                           VerticalAlignment="Center" Margin="10,0"/>
                    <Label x:Name="lbl_c0_instant" Grid.Row="3" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c0_moyenne" Grid.Row="3" Grid.Column="2"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c0_facteur" Grid.Row="3" Grid.Column="3"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c0_actuel" Grid.Row="3" Grid.Column="4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--" FontWeight="Bold"/>

                    <!-- C1 -->
                    <Label Content="C1" Grid.Row="4" Grid.Column="0"
                           VerticalAlignment="Center" Margin="10,0"/>
                    <Label x:Name="lbl_c1_instant" Grid.Row="4" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c1_moyenne" Grid.Row="4" Grid.Column="2"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c1_facteur" Grid.Row="4" Grid.Column="3"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c1_actuel" Grid.Row="4" Grid.Column="4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--" FontWeight="Bold"/>

                    <!-- C2 -->
                    <Label Content="C2" Grid.Row="5" Grid.Column="0"
                           VerticalAlignment="Center" Margin="10,0"/>
                    <Label x:Name="lbl_c2_instant" Grid.Row="5" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c2_moyenne" Grid.Row="5" Grid.Column="2"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c2_facteur" Grid.Row="5" Grid.Column="3"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c2_actuel" Grid.Row="5" Grid.Column="4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--" FontWeight="Bold"/>

                    <!-- C3 -->
                    <Label Content="C3" Grid.Row="6" Grid.Column="0"
                           VerticalAlignment="Center" Margin="10,0"/>
                    <Label x:Name="lbl_c3_instant" Grid.Row="6" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c3_moyenne" Grid.Row="6" Grid.Column="2"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c3_facteur" Grid.Row="6" Grid.Column="3"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_c3_actuel" Grid.Row="6" Grid.Column="4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--" FontWeight="Bold"/>

                    <!-- Desalinator -->
                    <Label Content="Desalinator" Grid.Row="7" Grid.Column="0"
                           VerticalAlignment="Center" Margin="10,0"/>
                    <Label x:Name="lbl_desalinator_instant" Grid.Row="7" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_desalinator_moyenne" Grid.Row="7" Grid.Column="2"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_desalinator_facteur" Grid.Row="7" Grid.Column="3"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--"/>
                    <Label x:Name="lbl_desalinator_actuel" Grid.Row="7" Grid.Column="4"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Content="--" FontWeight="Bold"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btn_demarrer" Content="Démarrer" Width="150" Height="35"
                    Margin="10" Click="btn_Demarrer_Click" FontSize="14" Background="#CCFFCC" FontWeight="Bold"/>
            <Button x:Name="btn_arreter" Content="Arrêter" Width="150" Height="35"
                    Margin="10" Click="btn_Arreter_Click" FontSize="14" Background="#FFCCCC" FontWeight="Bold"/>
            <Button x:Name="btn_valider_reference" Content="Valider référence" Width="150" Height="35"
                    Margin="10" Click="btn_ValiderReference_Click" FontSize="14" FontWeight="Bold"/>
            <Button x:Name="btn_reset_factors" Content="Réinitialiser facteurs" Width="170" Height="35"
                    Margin="10" Click="btn_ResetFactors_Click" FontSize="14" Background="#FFFFCC"/>
        </StackPanel>
    </Grid>
</Window>
